<div class="container card mt-5 col-4">
  <div class="card-header">
    <h1 class="text-primary">Delete conformation</h1>
  </div>
  <img src="data:image/png;base64,<%= concert.image %>" class="card-img-top" alt="<%= concert.name %>" width="400" height="200"/> 
  <div class="card-body">
    <h5 class="card-title"><%= concert.name %></h5>
      <h3 class="card-text">
          Are you sure you want to delete this concert?
      </h3>
    <form action="/delete-concert/<%= concert._id %>" method="post">
      <button type="submit" class="btn btn-danger me-2">Yes, Delete</button>
      <a href="/" class="btn btn-secondary">Cancel</a>
    </form>
    
  </div>
</div>


